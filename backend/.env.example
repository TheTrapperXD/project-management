# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
# At least 32 characters, random (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARS
# Frontend ORIGIN only (scheme+host, no path, no trailing slash), e.g. https://thetrapperxd.github.io
CORS_ORIGIN=http://localhost:5173
